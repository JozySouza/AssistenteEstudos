{
  "name": "assistente-estudos-backend",
  "version": "1.0.0",
  "description": "API do Assistente de Estudos com IA generativa (Gemini)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "coverageThreshold": {
      "global": { "statements": 70, "branches": 70, "functions": 70, "lines": 70 }
    }
  }
}
